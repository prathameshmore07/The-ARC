# ═══════════════════════════════════════════════════════
# THE ARC — Environment Variables (Supabase Only)
# ═══════════════════════════════════════════════════════

# Supabase Project
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase Service Role (server-only, NEVER expose to client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Database (Prisma)
DATABASE_URL=postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres

# Cron Secret (protects /api/cron/* routes)
CRON_SECRET=generate-a-random-secret-here

# Demo Mode (set to "true" only on the demo deployment, never production)
DEMO_MODE=false
